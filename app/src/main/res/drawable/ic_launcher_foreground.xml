<?xml version="1.0" encoding="utf-8"?>
<!-- Fit the original artwork inside the visible 72dp of the 108dp adaptive canvas.
     Android supplies the outer mask; do not pre-mask the artwork into a circle. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16.666667%"
    android:insetTop="16.666667%"
    android:insetRight="16.666667%"
    android:insetBottom="16.666667%">
    <bitmap android:src="@drawable/wandercraft_launcher_art"
        android:gravity="fill" android:filter="true" />
</inset>
